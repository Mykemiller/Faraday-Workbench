{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/thoughtforge-sync",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/admin/shell"
    },
    {
      "source": "/admin/:area",
      "destination": "/api/admin/shell?area=:area"
    },
    {
      "source": "/admin/:area/:id",
      "destination": "/api/admin/shell?area=:area&id=:id"
    }
  ]
}
